PORT=5000
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/store_rating
JWT_SECRET=YOUR_JWT_SECRET

# Used to build the password reset link that is printed in the backend terminal.
FRONTEND_URL=http://localhost:5173

# The first admin account, created by:  npm run create-admin
# ADMIN_NAME must be at most 60 characters.
# ADMIN_PASSWORD must be 8-16 characters with one uppercase letter and one special character.
ADMIN_NAME=YOUR_ADMIN_FULL_NAME
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD
ADMIN_ADDRESS=YOUR_ADMIN_ADDRESS
